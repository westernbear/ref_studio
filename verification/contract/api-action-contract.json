{
  "schemaVersion": "rvs-api-action-contract-v3",
  "schemaEncoding": "Every operation below is executable OpenAPI 3.1/JSON Schema authority. request.headers, request.path, request.query, request.body and success.body are schema objects or local $ref values. additionalProperties is false unless explicitly set. Generated OpenAPI 3.1 must round-trip these schemas byte-semantically before Todo 5.",
  "rowBinding": "Every non-local control row resolves by exact METHOD plus canonical path to one operation, except an explicitly declared composite control that resolves to its fixed ordered sequence; no UI may invent an operation.",
  "common": {
    "commandHeaders": ["Idempotency-Key", "X-Correlation-Id"],
    "editHeaders": ["If-Match", "Idempotency-Key", "X-Correlation-Id"],
    "directV1Auth": "Bearer plus X-Tenant-Id intersected with membership; tenant never comes from browser BFF claims. Sole exception: POST /v1/release-reviews forbids X-Tenant-Id and authorizes only a server-derived release-scope T6 assignment bound to releaseId.",
    "browserAuth": "same-origin BFF session plus origin-bound CSRF; BFF forwards only opaque sessionId plus CSRF assertion using an audience-limited session:introspect service credential",
    "adminAuth": "server-derived platform, tenant assignment or release assignment scope",
    "releaseReviewAuth": "POST /v1/release-reviews uses bearer auth plus a release-scope assignment; tenantId must be null, X-Tenant-Id must be absent, and no tenant membership can widen or replace release authorization.",
    "safeErrorSchema": {"$ref": "#/schemaDefinitions/SafeError"}
  },
  "coverage": {
    "directControlOperations": "derived by exact METHOD plus canonical-path match from the 151-row control contract",
    "compositeControls": {"upload_validation:8": ["POST /v1/uploads", "PUT /v1/uploads/{uploadId}/chunks/{index}", "POST /v1/uploads/{uploadId}/finalize"]},
    "screenLoadOrStateOperations": ["GET /v1/jobs/{jobId}", "GET /v1/jobs/{jobId}/attempts", "GET /v1/jobs/{jobId}/authoring-ir", "GET /v1/jobs/{jobId}/preview", "GET /v1/receipts", "GET /admin/tenants/{tenantId}/jobs", "GET /admin/jobs", "GET /admin/jobs/{jobId}", "GET /admin/receipts", "GET /admin/quarantine", "GET /admin/billing/{tenantId}"],
    "additionalRequiredControls": ["DELETE /auth/session", "POST /auth/active-tenant", "DELETE /v1/uploads/{uploadId}", "POST /v1/jobs/{jobId}/retry", "POST /v1/jobs/{jobId}/choices", "POST /admin/jobs/{jobId}/cancel", "POST /admin/jobs/{jobId}/retry", "POST /admin/quarantine/{itemId}/reject", "PATCH /admin/billing/{tenantId}", "GET /admin/receipt-exports/{exportId}", "GET /admin/receipt-exports/{exportId}/download", "GET /admin/audit-exports/{exportId}", "GET /admin/audit-exports/{exportId}/download"],
    "opsOnlyOperations": ["POST /v1/release-reviews", "POST /admin/queue/drain", "POST /admin/queue/resume", "POST /admin/reviewer-assignments", "DELETE /admin/reviewer-assignments/{assignmentId}"],
    "rule": "Every operation must be direct-control matched or listed exactly once in one non-direct category; zero unclassified operations. Additional controls are tested but do not increase the immutable 151 Stitch count. POST /v1/reviews is job-scope T1-T5 only; POST /v1/release-reviews is release-scope T6 only."
  },
  "schemaDefinitions": {
    "SafeError": {"type": "object", "required": ["code", "message", "correlationId"], "additionalProperties": false, "properties": {"code": {"type": "string", "pattern": "^[A-Z0-9_]+$"}, "message": {"type": "string", "minLength": 1, "maxLength": 300}, "correlationId": {"type": "string", "format": "uuid"}}},
    "Empty": {"type": "object", "additionalProperties": false, "properties": {}},
    "Uuid": {"type": "string", "format": "uuid"},
    "HexSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "TenantId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
    "UserId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
    "UploadId": {"type": "string", "pattern": "^upl_[A-Za-z0-9_-]{8,64}$"},
    "QuarantineItemId": {"type": "string", "pattern": "^qitem_[A-Za-z0-9_-]{8,64}$"},
    "JobId": {"type": "string", "pattern": "^job_[A-Za-z0-9_-]{8,64}$"},
    "JobAttemptId": {"type": "string", "pattern": "^attempt_[A-Za-z0-9_-]{8,64}$"},
    "ReleaseId": {"type": "string", "pattern": "^rel_[A-Za-z0-9_-]{8,64}$"},
    "ReceiptId": {"type": "string", "pattern": "^rcpt_[A-Za-z0-9_-]{8,64}$"},
    "ExportId": {"type": "string", "pattern": "^exp_[A-Za-z0-9_-]{8,64}$"},
    "AssignmentId": {"type": "string", "pattern": "^asg_[A-Za-z0-9_-]{8,64}$"},
    "ChoiceId": {"type": "string", "pattern": "^choice_[A-Za-z0-9_-]{8,64}$"},
    "Cursor": {"type": "string", "minLength": 1, "maxLength": 512},
    "Reason500": {"type": "string", "minLength": 1, "maxLength": 500},
    "Reason2000": {"type": "string", "minLength": 1, "maxLength": 2000},
    "IdempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
    "IfMatch": {"type": "string", "minLength": 1, "maxLength": 160},
    "CommandHeaders": {"type": "object", "required": ["Idempotency-Key", "X-Correlation-Id"], "additionalProperties": false, "properties": {"Idempotency-Key": {"$ref": "#/schemaDefinitions/IdempotencyKey"}, "X-Correlation-Id": {"$ref": "#/schemaDefinitions/Uuid"}}},
    "EditHeaders": {"type": "object", "required": ["If-Match", "Idempotency-Key", "X-Correlation-Id"], "additionalProperties": false, "properties": {"If-Match": {"$ref": "#/schemaDefinitions/IfMatch"}, "Idempotency-Key": {"$ref": "#/schemaDefinitions/IdempotencyKey"}, "X-Correlation-Id": {"$ref": "#/schemaDefinitions/Uuid"}}},
    "PageInfo": {"type": "object", "required": ["hasNextPage", "hasPreviousPage"], "additionalProperties": false, "properties": {"hasNextPage": {"type": "boolean"}, "hasPreviousPage": {"type": "boolean"}, "startCursor": {"$ref": "#/schemaDefinitions/Cursor"}, "endCursor": {"$ref": "#/schemaDefinitions/Cursor"}}},
    "PageQuery": {"type": "object", "additionalProperties": false, "properties": {"q": {"type": "string", "maxLength": 200}, "state": {"type": "string", "maxLength": 64}, "status": {"type": "string", "maxLength": 64}, "plan": {"type": "string", "maxLength": 64}, "eventType": {"type": "string", "maxLength": 80}, "outcome": {"type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"}, "range": {"type": "string", "maxLength": 80}, "object": {"type": "string", "maxLength": 160}, "tenant": {"$ref": "#/schemaDefinitions/TenantId"}, "actor": {"type": "string", "maxLength": 120}, "after": {"$ref": "#/schemaDefinitions/Cursor"}, "before": {"$ref": "#/schemaDefinitions/Cursor"}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}}},
    "JobProjection": {"type": "object", "required": ["jobId", "state", "tenantId"], "additionalProperties": true, "properties": {"jobId": {"$ref": "#/schemaDefinitions/JobId"}, "tenantId": {"$ref": "#/schemaDefinitions/TenantId"}, "state": {"enum": ["PREPARING", "QUEUED", "RENDERING", "COMPLETED", "CANCELLED", "FAILED"]}}},
    "AdminJobProjection": {"type": "object", "required": ["jobId", "tenantId", "internalState"], "additionalProperties": true, "properties": {"jobId": {"$ref": "#/schemaDefinitions/JobId"}, "tenantId": {"$ref": "#/schemaDefinitions/TenantId"}, "internalState": {"type": "string"}}},
    "Receipt": {"type": "object", "required": ["receiptId", "scope", "subjectId", "gate", "decision", "predecessorId", "decisionVersion"], "additionalProperties": true, "properties": {"receiptId": {"$ref": "#/schemaDefinitions/ReceiptId"}, "scope": {"enum": ["job", "release"]}, "subjectId": {"type": "string"}, "gate": {"enum": ["T1", "T2", "T3", "T4", "T5", "T6"]}, "decision": {"enum": ["APPROVED", "REJECTED"]}, "predecessorId": {"type": ["string", "null"]}, "decisionVersion": {"type": "integer", "minimum": 1}}},
    "UploadCreateRequest": {"type": "object", "required": ["fileName", "sizeBytes"], "additionalProperties": false, "properties": {"fileName": {"type": "string", "minLength": 1, "maxLength": 255}, "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 2147483648}, "sha256": {"$ref": "#/schemaDefinitions/HexSha256"}, "mimeHint": {"type": "string", "maxLength": 100}}},
    "ChunkHeaders": {"type": "object", "required": ["Content-Range", "X-Chunk-Sha256"], "additionalProperties": false, "properties": {"Content-Range": {"type": "string", "pattern": "^bytes [0-9]+-[0-9]+/[0-9]+$"}, "X-Chunk-Sha256": {"$ref": "#/schemaDefinitions/HexSha256"}}},
    "ChunkBody": {"type": "string", "contentEncoding": "binary", "maxLength": 8388608},
    "UploadFinalizeRequest": {"type": "object", "required": ["orderedChunkCount", "declaredSha256"], "additionalProperties": false, "properties": {"orderedChunkCount": {"type": "integer", "minimum": 1, "maximum": 262144}, "declaredSha256": {"$ref": "#/schemaDefinitions/HexSha256"}}},
    "JobCreateRequest": {"type": "object", "required": ["uploadId", "startFrame", "sourceFps", "outputProfile"], "additionalProperties": false, "properties": {"uploadId": {"$ref": "#/schemaDefinitions/UploadId"}, "startFrame": {"type": "integer", "minimum": 0}, "sourceFps": {"enum": [24, 25, 30, 50, 60]}, "outputProfile": {"const": "vertical-1080p30"}}},
    "ReasonRequest": {"type": "object", "required": ["reason"], "additionalProperties": false, "properties": {"reason": {"$ref": "#/schemaDefinitions/Reason500"}}},
    "EvidenceQuery": {"type": "object", "additionalProperties": false, "properties": {"layer": {"enum": ["ocr", "camera", "light", "owners", "audio", "all"]}}},
    "IRPatchRequest": {"type": "object", "required": ["ops", "reason"], "additionalProperties": false, "properties": {"reason": {"$ref": "#/schemaDefinitions/Reason500"}, "ops": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "required": ["op", "path", "value"], "additionalProperties": false, "properties": {"op": {"const": "replace"}, "path": {"type": "string", "pattern": "^/(copy|geometry|owners|passOrder|effects|assets)(/|$)"}, "value": {"type": ["string", "number", "integer", "boolean", "object", "array", "null"]}}}}}},
    "ChoiceResolveRequest": {"type": "object", "required": ["choiceId", "polygonOrOwner", "reason"], "additionalProperties": false, "properties": {"choiceId": {"$ref": "#/schemaDefinitions/ChoiceId"}, "polygonOrOwner": {"oneOf": [{"type": "object", "required": ["ownerId"], "additionalProperties": false, "properties": {"ownerId": {"type": "string", "minLength": 1, "maxLength": 100}}}, {"type": "object", "required": ["polygon"], "additionalProperties": false, "properties": {"polygon": {"type": "array", "minItems": 3, "maxItems": 64, "items": {"type": "object", "required": ["x", "y"], "additionalProperties": false, "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1080}, "y": {"type": "number", "minimum": 0, "maximum": 1920}}}}}}]}, "reason": {"$ref": "#/schemaDefinitions/Reason500"}}},
    "JobReviewRequest": {"type": "object", "required": ["scope", "subjectId", "gate", "decision", "reason", "evidenceDigest", "runtimeDigest", "predecessorId", "decisionVersion"], "additionalProperties": false, "properties": {"scope": {"const": "job"}, "subjectId": {"$ref": "#/schemaDefinitions/JobAttemptId"}, "gate": {"enum": ["T1", "T2", "T3", "T4", "T5"]}, "decision": {"enum": ["APPROVED", "REJECTED"]}, "reason": {"$ref": "#/schemaDefinitions/Reason2000"}, "evidenceDigest": {"$ref": "#/schemaDefinitions/HexSha256"}, "irDigest": {"$ref": "#/schemaDefinitions/HexSha256"}, "runtimeDigest": {"$ref": "#/schemaDefinitions/HexSha256"}, "predecessorId": {"type": ["string", "null"]}, "decisionVersion": {"type": "integer", "minimum": 1}}},
    "ReleaseReviewRequest": {"type": "object", "required": ["scope", "releaseId", "gate", "decision", "reason", "evidenceDigest", "runtimeDigest", "releaseBaselineDigest", "predecessorId", "decisionVersion"], "additionalProperties": false, "properties": {"scope": {"const": "release"}, "releaseId": {"$ref": "#/schemaDefinitions/ReleaseId"}, "gate": {"const": "T6"}, "decision": {"enum": ["APPROVED", "REJECTED"]}, "reason": {"$ref": "#/schemaDefinitions/Reason2000"}, "evidenceDigest": {"$ref": "#/schemaDefinitions/HexSha256"}, "runtimeDigest": {"$ref": "#/schemaDefinitions/HexSha256"}, "releaseBaselineDigest": {"$ref": "#/schemaDefinitions/HexSha256"}, "predecessorId": {"$ref": "#/schemaDefinitions/HexSha256"}, "decisionVersion": {"type": "integer", "minimum": 1}}},
    "RenderRequest": {"type": "object", "required": ["irDigest", "approvalDigest", "outputProfile"], "additionalProperties": false, "properties": {"irDigest": {"$ref": "#/schemaDefinitions/HexSha256"}, "approvalDigest": {"$ref": "#/schemaDefinitions/HexSha256"}, "outputProfile": {"const": "vertical-1080p30"}}},
    "QuarantineDecisionRequest": {"type": "object", "required": ["reason", "confirmTenantId", "confirmItemId"], "additionalProperties": false, "properties": {"reason": {"$ref": "#/schemaDefinitions/Reason500"}, "confirmTenantId": {"$ref": "#/schemaDefinitions/TenantId"}, "confirmItemId": {"$ref": "#/schemaDefinitions/QuarantineItemId"}}},
    "BillingPatchRequest": {"type": "object", "required": ["reason"], "additionalProperties": false, "properties": {"planMetadata": {"type": "object", "maxProperties": 20, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}}, "quotaBytes": {"type": "integer", "minimum": 0, "maximum": 10995116277760}, "reason": {"$ref": "#/schemaDefinitions/Reason500"}}},
    "ExportCreateRequest": {"type": "object", "required": ["format"], "additionalProperties": false, "properties": {"tenantId": {"$ref": "#/schemaDefinitions/TenantId"}, "jobId": {"$ref": "#/schemaDefinitions/JobId"}, "gate": {"enum": ["T1", "T2", "T3", "T4", "T5", "T6"]}, "q": {"type": "string", "maxLength": 200}, "eventType": {"type": "string", "maxLength": 80}, "outcome": {"type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"}, "actor": {"type": "string", "maxLength": 120}, "range": {"type": "string", "maxLength": 80}, "format": {"const": "jsonl"}}},
    "ReviewerAssignmentRequest": {"oneOf": [{"type": "object", "required": ["scope", "tenantId", "userId", "gate", "reason"], "additionalProperties": false, "properties": {"scope": {"const": "job"}, "tenantId": {"$ref": "#/schemaDefinitions/TenantId"}, "userId": {"$ref": "#/schemaDefinitions/UserId"}, "gate": {"enum": ["T1", "T2", "T3", "T4", "T5"]}, "reason": {"$ref": "#/schemaDefinitions/Reason500"}}}, {"type": "object", "required": ["scope", "releaseId", "userId", "gate", "reason"], "additionalProperties": false, "properties": {"scope": {"const": "release"}, "releaseId": {"$ref": "#/schemaDefinitions/ReleaseId"}, "userId": {"$ref": "#/schemaDefinitions/UserId"}, "gate": {"const": "T6"}, "reason": {"$ref": "#/schemaDefinitions/Reason500"}}}]},
    "TenantMembersPatchRequest": {"type": "object", "required": ["reason"], "additionalProperties": false, "properties": {"addOrUpdate": {"type": "object", "required": ["userId", "role"], "additionalProperties": false, "properties": {"userId": {"$ref": "#/schemaDefinitions/UserId"}, "role": {"enum": ["OWNER", "ADMIN", "MEMBER"]}}}, "removeUserId": {"$ref": "#/schemaDefinitions/UserId"}, "reason": {"$ref": "#/schemaDefinitions/Reason500"}}},
    "UploadSession": {"type": "object", "required": ["uploadId", "chunkSize", "expiresAt", "state"], "additionalProperties": false, "properties": {"uploadId": {"$ref": "#/schemaDefinitions/UploadId"}, "chunkSize": {"type": "integer", "minimum": 1}, "expiresAt": {"type": "string", "format": "date-time"}, "state": {"type": "string"}}},
    "ExportStatus": {"type": "object", "required": ["exportId", "state", "expiresAt", "downloadReady"], "additionalProperties": false, "properties": {"exportId": {"$ref": "#/schemaDefinitions/ExportId"}, "state": {"enum": ["PENDING", "READY", "FAILED"]}, "expiresAt": {"type": "string", "format": "date-time"}, "downloadReady": {"type": "boolean"}}}
  },
  "operations": [
    {"key": "POST /auth/session", "request": {"body": {"type": "object", "required": ["identifier", "secret", "surface"], "additionalProperties": false, "properties": {"identifier": {"type": "string", "minLength": 1, "maxLength": 254}, "secret": {"type": "string", "minLength": 1, "maxLength": 1024}, "surface": {"enum": ["creator", "admin"]}, "returnTo": {"type": "string", "pattern": "^/[A-Za-z0-9/_?=&.-]*$", "maxLength": 512}}}}, "success": {"status": 204, "headers": {"Set-Cookie": {"type": "string"}, "X-Redirect-To": {"type": "string"}}}, "state": "anonymous", "idem": "duplicate-submit guard", "audit": "AUTH_LOGIN_ATTEMPT", "errors": ["INVALID_CREDENTIALS", "CSRF_INVALID", "RETURN_URL_INVALID"]},
    {"key": "DELETE /auth/session", "request": {"body": {"$ref": "#/schemaDefinitions/Empty"}}, "success": {"status": 204, "body": {"$ref": "#/schemaDefinitions/Empty"}}, "state": "authenticated", "idem": "safe replay", "audit": "SESSION_REVOKED", "errors": ["AUTH_REQUIRED"]},
    {"key": "POST /auth/active-tenant", "request": {"headers": {"$ref": "#/schemaDefinitions/CommandHeaders"}, "body": {"type": "object", "required": ["tenantId"], "additionalProperties": false, "properties": {"tenantId": {"$ref": "#/schemaDefinitions/TenantId"}}}}, "success": {"status": 200, "body": {"type": "object", "required": ["tenantId", "csrfRotated"], "additionalProperties": true, "properties": {"tenantId": {"$ref": "#/schemaDefinitions/TenantId"}, "csrfRotated": {"type": "boolean"}}}}, "state": "authenticated membership", "idem": "required", "audit": "ACTIVE_TENANT_CHANGED", "errors": ["TENANT_FORBIDDEN"]},
    {"key": "GET /health", "request": {"query": {"$ref": "#/schemaDefinitions/Empty"}}, "success": {"status": 200, "body": {"type": "object", "required": ["status", "checks"], "additionalProperties": false, "properties": {"status": {"enum": ["ok", "degraded"]}, "checks": {"type": "object", "additionalProperties": {"type": "string"}}}}}, "state": "public", "idem": "n/a", "audit": "none", "errors": ["HEALTH_UNAVAILABLE"]},
    {"key": "POST /v1/uploads", "request": {"headers": {"$ref": "#/schemaDefinitions/CommandHeaders"}, "body": {"$ref": "#/schemaDefinitions/UploadCreateRequest"}}, "success": {"status": 201, "body": {"$ref": "#/schemaDefinitions/UploadSession"}}, "state": "tenant OWNER|ADMIN; disk admitted", "idem": "required", "audit": "UPLOAD_SESSION_CREATED", "errors": ["VIDEO_SIZE_LIMIT_EXCEEDED", "QUOTA_EXCEEDED"]},
    {"key": "PUT /v1/uploads/{uploadId}/chunks/{index}", "request": {"headers": {"$ref": "#/schemaDefinitions/ChunkHeaders"}, "path": {"type": "object", "required": ["uploadId", "index"], "additionalProperties": false, "properties": {"uploadId": {"$ref": "#/schemaDefinitions/UploadId"}, "index": {"type": "integer", "minimum": 0}}}, "body": {"$ref": "#/schemaDefinitions/ChunkBody"}}, "success": {"status": 204, "headers": {"X-Received-Bytes": {"type": "integer", "minimum": 0}}}, "state": "open upload owned by tenant", "idem": "chunk index+hash", "audit": "none", "errors": ["UPLOAD_RANGE_INVALID", "UPLOAD_EXPIRED", "TENANT_FORBIDDEN"]},
    {"key": "POST /v1/uploads/{uploadId}/finalize", "request": {"headers": {"$ref": "#/schemaDefinitions/CommandHeaders"}, "path": {"type": "object", "required": ["uploadId"], "additionalProperties": false, "properties": {"uploadId": {"$ref": "#/schemaDefinitions/UploadId"}}}, "body": {"$ref": "#/schemaDefinitions/UploadFinalizeRequest"}}, "success": {"status": 202, "body": {"type": "object", "required": ["uploadId", "state"], "additionalProperties": false, "properties": {"uploadId": {"$ref": "#/schemaDefinitions/UploadId"}, "state": {"const": "VALIDATING"}}}}, "state": "all chunks present", "idem": "required", "audit": "UPLOAD_FINALIZED", "errors": ["UPLOAD_INCOMPLETE", "HASH_MISMATCH", "QUOTA_EXCEEDED"]},
    {"key": "DELETE /v1/uploads/{uploadId}", "request": {"path": {"type": "object", "required": ["uploadId"], "additionalProperties": false, "properties": {"uploadId": {"$ref": "#/schemaDefinitions/UploadId"}}}, "body": {"$ref": "#/schemaDefinitions/Empty"}}, "success": {"status": 202, "body": {"type": "object", "required": ["state"], "additionalProperties": false, "properties": {"state": {"enum": ["abort-requested", "aborted"]}}}}, "state": "open nonterminal upload", "idem": "safe replay", "audit": "UPLOAD_ABORTED", "errors": ["UPLOAD_NOT_ABORTABLE", "TENANT_FORBIDDEN"]},
    {"key": "POST /v1/jobs", "request": {"headers": {"$ref": "#/schemaDefinitions/CommandHeaders"}, "body": {"$ref": "#/schemaDefinitions/JobCreateRequest"}}, "success": {"status": 201, "body": {"$ref": "#/schemaDefinitions/JobProjection"}}, "state": "uploadState=ACCEPTED with normalizedArtifactId resolved server-side; exact 4s frame interval", "idem": "required", "audit": "JOB_CREATED", "errors": ["COMPILER_ADMISSION_BLOCKED", "INTERVAL_INVALID", "TENANT_FORBIDDEN"]},
    {"key": "GET /v1/jobs", "request": {"query": {"$ref": "#/schemaDefinitions/PageQuery"}}, "success": {"status": 200, "body": {"type": "object", "required": ["items", "pageInfo"], "additionalProperties": false, "properties": {"items": {"type": "array", "items": {"$ref": "#/schemaDefinitions/JobProjection"}}, "pageInfo": {"$ref": "#/schemaDefinitions/PageInfo"}}}}, "state": "tenant member", "idem": "n/a", "audit": "none", "errors": ["CURSOR_INVALID"]},
    {"key": "GET /v1/jobs/{jobId}", "request": {"path": {"type": "object", "required": ["jobId"], "additionalProperties": false, "properties": {"jobId": {"$ref": "#/schemaDefinitions/JobId"}}}}, "success": {"status": 200, "body": {"$ref": "#/schemaDefinitions/JobProjection"}}, "state": "tenant member", "idem": "n/a", "audit": "JOB_VIEWED", "errors": ["JOB_NOT_FOUND"]},
    {"key": "GET /v1/jobs/{jobId}/attempts", "request": {"path": {"type": "object", "required": ["jobId"], "additionalProperties": false, "properties": {"jobId": {"$ref": "#/schemaDefinitions/JobId"}}}, "query": {"$ref": "#/schemaDefinitions/PageQuery"}}, "success": {"status": 200, "body": {"type": "object", "required": ["items", "pageInfo"], "additionalProperties": false, "properties": {"items": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "pageInfo": {"$ref": "#/schemaDefinitions/PageInfo"}}}}, "state": "tenant member", "idem": "n/a", "audit": "JOB_VIEWED", "errors": ["JOB_NOT_FOUND"]},
    {"key": "POST /v1/jobs/{jobId}/cancel", "request": {"headers": {"$ref": "#/schemaDefinitions/EditHeaders"}, "path": {"type": "object", "required": ["jobId"], "additionalProperties": false, "properties": {"jobId": {"$ref": "#/schemaDefinitions/JobId"}}}, "body": {"$ref": "#/schemaDefinitions/ReasonRequest"}}, "success": {"status": 202, "body": {"type": "object", "required": ["state"], "additionalProperties": false, "properties": {"state": {"const": "CANCEL_REQUESTED"}}}}, "state": "QUEUED|PREPARING|RENDERING", "idem": "required", "audit": "JOB_CANCEL_REQUESTED", "errors": ["JOB_NOT_CANCELLABLE", "VERSION_CONFLICT"]},
    {"key": "POST /v1/jobs/{jobId}/retry", "request": {"headers": {"$ref": "#/schemaDefinitions/EditHeaders"}, "path": {"type": "object", "required": ["jobId"], "additionalProperties": false, "properties": {"jobId": {"$ref": "#/schemaDefinitions/JobId"}}}, "body": {"$ref": "#/schemaDefinitions/ReasonRequest"}}, "success": {"status": 201, "body": {"$ref": "#/schemaDefinitions/JobProjection"}}, "state": "retryable failed attempt; cap policy", "idem": "required", "audit": "JOB_RETRY_REQUESTED", "errors": ["JOB_NOT_RETRYABLE", "RETRY_LIMIT_EXCEEDED"]},
    {"key": "GET /v1/jobs/{jobId}/evidence", "request": {"path": {"type": "object", "required": ["jobId"], "additionalProperties": false, "properties": {"jobId": {"$ref": "#/schemaDefinitions/JobId"}}}, "query": {"$ref": "#/schemaDefinitions/EvidenceQuery"}}, "success": {"status": 200, "body": {"type": "object", "required": ["version", "state", "layers"], "additionalProperties": true, "properties": {"version": {"type": "integer", "minimum": 1}, "state": {"enum": ["OBSERVED", "MAPPED", "NEEDS_CHOICE"]}, "layers": {"type": "object"}}}}, "state": "evidence published; tenant member or assigned reviewer", "idem": "n/a", "audit": "EVIDENCE_VIEWED", "errors": ["EVIDENCE_UNAVAILABLE"]},
