{
  "schemaVersion": "rvs-audit-registry-v2",
  "closed": true,
  "events": [
    "ADMIN_LOGIN",
    "AUTH_LOGIN_ATTEMPT",
    "ADMIN_LOGOUT",
    "ADMIN_ACCESS_DENIED",
    "TENANT_VIEWED",
    "TENANT_STATUS_CHANGED",
    "TENANT_ROLE_CHANGED",
    "TENANT_ACCESS_CHANGED",
    "TENANT_SUSPENDED",
    "TENANT_DELETED",
    "JOB_CANCEL_REQUESTED",
    "JOB_RETRY_REQUESTED",
    "JOB_QUEUE_DRAIN_REQUESTED",
    "JOB_QUEUE_RESUME_REQUESTED",
    "QUARANTINE_VIEWED",
    "QUARANTINE_RETAINED",
    "QUARANTINE_RELEASE_REVIEWED",
    "RECEIPT_CHAIN_VIEWED",
    "AUDIT_LOG_VIEWED",
    "AUDIT_EXPORT_CREATED",
    "AUDIT_EXPORT_DOWNLOADED",
    "PLAN_VIEWED",
    "PLAN_METADATA_CHANGED",
    "QUOTA_VIEWED",
    "QUOTA_CHANGED",
    "BILLING_METADATA_VIEWED",
    "BILLING_METADATA_CHANGED",
    "SESSION_REVOKED",
    "ACTIVE_TENANT_CHANGED",
    "UPLOAD_SESSION_CREATED",
    "UPLOAD_FINALIZED",
    "UPLOAD_ABORTED",
    "JOB_CREATED",
    "JOB_VIEWED",
    "ARTIFACT_DOWNLOADED",
    "EVIDENCE_VIEWED",
    "IR_VIEWED",
    "IR_VERSION_CREATED",
    "EVIDENCE_CHOICE_RESOLVED",
    "GATE_DECISION_RECORDED",
    "RENDER_REQUESTED",
    "REVIEWER_ASSIGNED",
    "REVIEWER_ASSIGNMENT_REVOKED"
  ],
  "outcomeMappings": {
    "POST /auth/session": {
      "event": "AUTH_LOGIN_ATTEMPT",
      "outcome": "success|failure",
      "surface": "creator|admin"
    },
    "POST /admin/quarantine/{itemId}/release": {
      "event": "QUARANTINE_RELEASE_REVIEWED",
      "outcome": "revalidation_created|blocked",
      "note": "success creates a linked VALIDATING upload while original remains QUARANTINED; it never means accepted artifact released"
    },
    "POST /admin/receipt-exports": "AUDIT_EXPORT_CREATED",
    "GET /admin/receipt-exports/{exportId}/download": "AUDIT_EXPORT_DOWNLOADED",
    "POST /admin/audit-exports": "AUDIT_EXPORT_CREATED",
    "GET /admin/audit-exports/{exportId}/download": "AUDIT_EXPORT_DOWNLOADED"
  },
  "aliasesForbidden": {
    "RECEIPT_VIEWED": "RECEIPT_CHAIN_VIEWED",
    "RECEIPT_EXPORT_CREATED": "AUDIT_EXPORT_CREATED",
    "QUARANTINE_RELEASED": "QUARANTINE_RELEASE_REVIEWED",
    "TENANT_LIST_VIEWED": "TENANT_VIEWED",
    "AUTH_LOGIN_SUCCEEDED_OR_FAILED": "AUTH_LOGIN_ATTEMPT with outcome",
    "UPLOAD_CREATED_OR_QUARANTINED": "UPLOAD_SESSION_CREATED then UPLOAD_FINALIZED"
  }
}
