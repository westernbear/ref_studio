{
  "schemaVersion": "rvs-architecture-security-rules-v1",
  "forbiddenScope": ["reverse-dependencies", "duplicated-lifecycle-authority", "duplicated-rbac-authority", "unapproved-oversized-module", "shell-string-child-process", "unparameterized-sql", "unsafe-path-network", "secret-logging", "unfenced-repository", "mutable-history", "leaked-resource"],
  "requiredFiles": ["package.json", "pnpm-lock.yaml", "docker-compose.yml", "verification/contract/verification-contract.json", "verification/contract/controls.jsonl", "verification/contract/wcag-aa.json", "verification/contract/visual/index.json", "compiler/model-manifest.json", "apps/api/openapi.json", "runtime/runtime-manifest.json", "dist/final-handoff-package.zip"],
  "checks": [
    {"id":"compose-isolation","type":"compose","qaNetwork":"none","auditNoAppnet":true,"auditNoDatabaseMount":true,"auditNoCasMount":true},
    {"id":"forbidden-source-patterns","type":"source-regex","roots":["apps","packages","compiler"],"patterns":["\\bas any\\b","child_process\\.(exec|execFileSync|spawnSync)\\([^\\n]*\\+","shell\\s*:\\s*true","TODO|FIXME|HACK"]},
    {"id":"history-and-fencing","type":"source-regex","roots":["apps/api","apps/worker"],"patterns":["UPDATE\\s+(receipts|audit_events|authoring_ir_versions|scene_ir_versions|browser_pass_spec_versions)","DELETE\\s+FROM\\s+(receipts|audit_events)"]},
    {"id":"control-count","type":"jsonl-count","path":"verification/contract/controls.jsonl","expected":151,"uniqueField":"id"},
    {"id":"scope-boundary","type":"scope-regex","roots":["apps","packages","compiler"],"patterns":["diffusion|password-reset|scale.?out|horizontal worker|five.?minute|production.?quality claim"]}
  ]
}
