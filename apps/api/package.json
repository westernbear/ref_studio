{
  "name": "@rvs/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && mkdir -p dist/apps/api/database && cp -R database/db.mjs database/seed.sql database/migrations dist/apps/api/database/",
    "test": "vitest",
    "start": "node dist/apps/api/src/server.js",
    "db:reset": "node database/cli.mjs reset",
    "db:migrate": "node database/cli.mjs migrate",
    "db:verify": "node database/cli.mjs verify",
    "db:test": "node database/test.mjs"
  },
  "dependencies": {
    "@rvs/contracts": "workspace:*",
    "@ai-sdk/alibaba": "2.0.35",
    "@ai-sdk/anthropic": "4.0.42",
    "@ai-sdk/baseten": "2.1.15",
    "@ai-sdk/cerebras": "3.0.37",
    "@ai-sdk/cohere": "4.0.30",
    "@ai-sdk/deepinfra": "3.0.37",
    "@ai-sdk/deepseek": "3.0.32",
    "@ai-sdk/fireworks": "3.0.40",
    "@ai-sdk/google": "4.0.51",
    "@ai-sdk/groq": "4.0.31",
    "@ai-sdk/huggingface": "2.0.37",
    "@ai-sdk/mistral": "4.0.33",
    "@ai-sdk/moonshotai": "3.0.38",
    "@ai-sdk/openai": "4.0.47",
    "@ai-sdk/perplexity": "4.0.32",
    "@ai-sdk/togetherai": "3.0.38",
    "@ai-sdk/xai": "4.0.44",
    "ai": "7.0.79",
    "better-sqlite3": "12.2.0",
    "fastify": "5.8.5",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
