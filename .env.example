RVS_INITIAL_ADMIN_EMAIL=admin@example.test
RVS_INITIAL_ADMIN_PASSWORD=change-me
RVS_INITIAL_ADMIN_NAME=Platform Operator
RVS_INTERNAL_API_URL=http://api:3200
RVS_INSECURE_COOKIES=true
RVS_WORKER_TOKEN=replace-with-a-random-worker-token
# Set this to the exact browser origin, for example http://192.168.1.10:3100.
RVS_EXPECTED_ORIGIN=http://localhost:3100
RVS_SESSION_INTROSPECT_SECRET=change-me-too
# Optional. The Codex model registry gates its list on the CLI version that
# asks, as a floor -- too low and models are silently missing. Raise this if
# a model you know the account has is not in the console's picker.
RVS_CODEX_CLIENT_VERSION=0.150.1
