{
  "name": "reference-video-studio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "supply:resolve-exact": "node scripts/supply/resolve-exact.mjs",
    "supply:hydrate": "node scripts/supply/hydrate.mjs",
    "fixtures:lock": "node scripts/fixtures/lock.mjs",
    "fixtures:generate": "node scripts/fixtures/lock.mjs --contract .omo/drafts/reference-video-studio-saas-fixture-contract-v2.json --verify-lock",
    "fixtures:verify": "node scripts/fixtures/verify.mjs",
    "runtime:verify-config": "node scripts/runtime/verify-frozen-config.mjs",
    "runtime:finalize-manifests": "node scripts/runtime/finalize-manifests.mjs",
    "authority:emit-child-root": "node scripts/supply/emit-child-root.mjs",
    "qa": "node scripts/stub.mjs qa",
    "lint": "node scripts/stub.mjs lint",
    "typecheck": "pnpm --filter contracts build",
    "contracts:openapi": "node scripts/contracts/openapi.mjs",
    "test": "node scripts/stub.mjs test",
    "build": "node scripts/stub.mjs build",
    "assets:verify": "node scripts/assets/verify.mjs",
    "media:verify": "node scripts/media/verify.mjs",
    "controls:validate": "node scripts/controls/validate.mjs --write && node scripts/controls/validate.mjs",
    "controls:coverage": "node scripts/controls/coverage.mjs",
    "verify:authority": "node verification/blackbox/verify-authority-root.mjs --root .omo/drafts/reference-video-studio-saas-authority-root.md"
     ,"qa:self-test": "node scripts/qa/self-test.mjs"
     ,"pilot:admission": "node scripts/pilot/admission.mjs"
     ,"pilot:run": "node scripts/pilot/run.mjs"
     ,"pilot:verify": "node scripts/pilot/verify.mjs"
    ,"test:security": "pnpm --filter @rvs/api test --run && pnpm --filter @rvs/worker test --run src/compiler-orchestrator.test.ts src/capture/smoke.test.ts src/render-app/dom-renderer.test.ts src/render-app/webgl.test.ts src/delivery.test.ts"
    ,"test:concurrency": "pnpm --filter @rvs/worker test --run src/queue.test.ts src/orchestration.test.ts"
     ,"qa:task43-evidence": "node scripts/qa/archive-task43.mjs"
     ,"deploy:verify": "node scripts/deploy/verify.mjs"
     ,"recovery:test": "node scripts/recovery/test.mjs"
     ,"handoff:build": "node scripts/handoff/build.mjs"
     ,"handoff:verify": "node scripts/handoff/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "axe-core": "4.10.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
