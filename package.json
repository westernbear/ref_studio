{
  "name": "reference-video-studio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "supply:resolve-exact": "node scripts/supply/resolve-exact.mjs",
    "supply:hydrate": "node scripts/supply/hydrate.mjs",
    "fixtures:lock": "node scripts/fixtures/lock.mjs",
    "runtime:verify-config": "node scripts/runtime/verify-frozen-config.mjs",
    "runtime:finalize-manifests": "node scripts/runtime/finalize-manifests.mjs",
    "authority:emit-child-root": "node scripts/supply/emit-child-root.mjs",
    "qa": "pnpm lint && pnpm test && pnpm build",
    "lint": "pnpm format:check && pnpm typecheck && pnpm contracts:openapi:check",
    "format": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern '*.*' 'apps/*/*.*' 'apps/*/{compiler,database,scripts,src,test}/**/*' 'compiler/**/*' 'dist/**/*' 'docs/**/*' 'examples/**/*' 'packages/**/*' 'runtime/**/*' 'scripts/**/*' 'tests/**/*' 'verification/**/*'",
    "format:check": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern '*.*' 'apps/*/*.*' 'apps/*/{compiler,database,scripts,src,test}/**/*' 'compiler/**/*' 'dist/**/*' 'docs/**/*' 'examples/**/*' 'packages/**/*' 'runtime/**/*' 'scripts/**/*' 'tests/**/*' 'verification/**/*'",
    "typecheck": "pnpm --filter @rvs/contracts build && pnpm --filter @rvs/api build && pnpm --filter @rvs/worker build && pnpm --filter @rvs/web exec tsc --noEmit",
    "contracts:openapi": "node scripts/contracts/openapi.mjs",
    "contracts:openapi:check": "node scripts/contracts/openapi.mjs --check",
    "test": "pnpm --filter @rvs/contracts test && pnpm --filter @rvs/api test --run && pnpm --filter @rvs/worker test --run && pnpm --filter @rvs/web test --run",
    "build": "pnpm --filter @rvs/contracts build && pnpm --filter @rvs/api build && pnpm --filter @rvs/worker build && pnpm --filter @rvs/web build",
    "assets:verify": "node scripts/assets/verify.mjs",
    "media:verify": "node scripts/media/verify.mjs",
    "controls:validate": "node scripts/controls/validate.mjs --write",
    "verify:authority": "node verification/blackbox/verify-authority-root.mjs --root .omo/drafts/reference-video-studio-saas-authority-root.md",
    "test:evidence": "node scripts/qa/assert-evidence.test.mjs",
    "test:concurrency": "pnpm --filter @rvs/api test --run src/tenant\\|idempotency\\|safe-error\\|auth.test.ts",
    "pilot:admission": "node scripts/pilot/admission.mjs",
    "pilot:run": "node scripts/pilot/run.mjs",
    "pilot:verify": "node scripts/pilot/verify.mjs",
    "test:security": "pnpm --filter @rvs/api test --run && pnpm --filter @rvs/worker test --run src/compiler-orchestrator.test.ts src/render-app/dom-renderer.test.ts src/render-app/webgl.test.ts src/worker-daemon.test.ts",
    "deploy:verify": "node scripts/deploy/verify.mjs",
    "handoff:build": "node scripts/handoff/build.mjs",
    "handoff:verify": "node scripts/handoff/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "axe-core": "4.10.3",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
